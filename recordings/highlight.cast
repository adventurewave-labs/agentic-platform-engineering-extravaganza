[13.535521, "o", "  \u001b[38;5;240m 1.\u001b[0m \u001b[1m\u001b[38;5;203mNW-FIN-001\u001b[0m  \u001b[38;5;255mpayments-ledger/prod: estimated $463.15/mo exceeds the CC-4471 budget of\u001b[0m\r\n                  \u001b[38;5;255m$400.00/mo by $63.15\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mright-size the largest line item or request a budget increase from the cost-center\u001b[0m\r\n            \u001b[38;5;214mowner\u001b[0m\r\n"]
[13.595832, "o", "\r\n    \u001b[1m\u001b[38;5;141magent \u2192\u001b[0m \u001b[38;5;245m1 input change(s), then re-render from source\u001b[0m\r\n      \u001b[38;5;240m\u00b7\u001b[0m \u001b[38;5;255mdb_instance_class\u001b[0m \u001b[38;5;203mdb.t4g.large\u001b[0m \u001b[38;5;240m\u2192\u001b[0m \u001b[1m\u001b[38;5;84mdb.t4g.medium\u001b[0m\r\n        \u001b[38;5;240mlargest reducible line item; db.t4g.large -> db.t4g.medium stays inside the cost-centre\u001b[0m\r\n        \u001b[38;5;240menvelope\u001b[0m\r\n"]
