[11.808304, "o", "  \u001b[38;5;207m\u258d\u001b[0m \u001b[1m\u001b[38;5;207mITERATION 1\u001b[0m   \u001b[38;5;240m$960.82/mo vs $400.00 budget\u001b[0m\r\n"]
[12.158681, "o", "  \u001b[38;5;240m 1.\u001b[0m \u001b[1m\u001b[38;5;203mNW-PCI-003\u001b[0m  \u001b[38;5;255mSQLInstance/nw-payments-ledger-prod: backupRetentionDays=7 is below the 30-day\u001b[0m\r\n                  \u001b[38;5;255mPCI floor\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mset spec.parameters.backupRetentionDays>=30\u001b[0m\r\n"]
[12.219047, "o", "  \u001b[38;5;240m 2.\u001b[0m \u001b[1m\u001b[38;5;203mNW-FIN-001\u001b[0m  \u001b[38;5;255mpayments-ledger/prod: estimated $960.82/mo exceeds the CC-4471 budget of\u001b[0m\r\n                  \u001b[38;5;255m$400.00/mo by $560.82\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mright-size the largest line item or request a budget increase from the cost-center\u001b[0m\r\n            \u001b[38;5;214mowner\u001b[0m\r\n"]
[12.27931, "o", "  \u001b[38;5;240m 3.\u001b[0m \u001b[1m\u001b[38;5;203mNW-FIN-003\u001b[0m  \u001b[38;5;255mpayments-ledger/prod: resource \"payments-ledger-postgres\" is $820.67/mo \u2014 85% of\u001b[0m\r\n                  \u001b[38;5;255mthe whole service budget\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214msingle line items over 70% need an explicit exception annotation from the cost-center\u001b[0m\r\n            \u001b[38;5;214mowner\u001b[0m\r\n"]
[12.339538, "o", "\r\n    \u001b[1m\u001b[38;5;141magent \u2192\u001b[0m \u001b[38;5;245m2 input change(s), then re-render from source\u001b[0m\r\n      \u001b[38;5;240m\u00b7\u001b[0m \u001b[38;5;255mdb_backup_retention_days\u001b[0m \u001b[38;5;203m7\u001b[0m \u001b[38;5;240m\u2192\u001b[0m \u001b[1m\u001b[38;5;84m30\u001b[0m\r\n        \u001b[38;5;240mPCI requires a 30-day minimum recovery window\u001b[0m\r\n"]
[12.419876, "o", "      \u001b[38;5;240m\u00b7\u001b[0m \u001b[38;5;255mdb_instance_class\u001b[0m \u001b[38;5;203mdb.r6g.xlarge\u001b[0m \u001b[38;5;240m\u2192\u001b[0m \u001b[1m\u001b[38;5;84mdb.t4g.large\u001b[0m\r\n        \u001b[38;5;240mlargest reducible line item; db.r6g.xlarge -> db.t4g.large stays inside the cost-centre\u001b[0m\r\n        \u001b[38;5;240menvelope\u001b[0m\r\n"]
