[3.705181, "o", "\r                                                                                                   \r  \u001b[38;5;84m\u2714\u001b[0m 3 manifests generated: Deployment, Service, StatefulSet\r\n\r\n\u001b[38;5;240m\u256d\u2500 what came back \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;240mimage:\u001b[0m     \u001b[38;5;255mpayments-ledger:latest\u001b[0m                                                             \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;240mreplicas:\u001b[0m  \u001b[38;5;255m1\u001b[0m                                                                                  \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;240menv:\u001b[0m       \u001b[38;5;255mDB_PASSWORD=postgres\u001b[0m                                                               \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;240mservice:\u001b[0m   \u001b[38;5;255mtype: LoadBalancer\u001b[0m                                                                 \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;240mdatabase:\u001b[0m  \u001b[38;5;255mStatefulSet, postgres:latest, no PVC\u001b[0m                                               \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n\r\n  \u001b[38;5;245mIt parses. It applies. It would pass a review from anyone\u001b[0m\r\n  \u001b[38;5;245mwho was not looking hard. Run it past the policy bundle.\u001b[0m\r\n\r\n\r  \u001b[38;5;51m\u280b\u001b[0m conftest test --policy policy/kubernetes   "]
