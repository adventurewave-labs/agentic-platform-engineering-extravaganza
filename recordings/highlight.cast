[5.406649, "o", "  \u001b[38;5;240m 1.\u001b[0m \u001b[1m\u001b[38;5;203mNW-K8S-001\u001b[0m  \u001b[38;5;255mDeployment/payments-ledger container \"payments-ledger\": image\u001b[0m\r\n                  \u001b[38;5;255m\"payments-ledger:latest\" is not immutably pinned\u001b[0m\r\n"]
[5.406667, "o", "      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mpin to a semver tag or @sha256 digest in score.yaml containers.payments-ledger.image\u001b[0m\r\n"]
[5.456999, "o", "  \u001b[38;5;240m 2.\u001b[0m \u001b[1m\u001b[38;5;203mNW-K8S-001\u001b[0m  \u001b[38;5;255mStatefulSet/payments-ledger-db container \"postgres\": image \"postgres:latest\" is\u001b[0m\r\n"]
[5.457076, "o", "                  \u001b[38;5;255mnot immutably pinned\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mpin to a semver tag or @sha256 digest in score.yaml containers.postgres.image\u001b[0m\r\n"]
[5.507325, "o", "  \u001b[38;5;240m 3.\u001b[0m \u001b[1m\u001b[38;5;203mNW-K8S-002\u001b[0m  \u001b[38;5;255mDeployment/payments-ledger container \"payments-ledger\": no CPU limit\u001b[0m\r\n"]
