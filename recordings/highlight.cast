[11.476598, "o", "\r\n\u001b[38;5;207m\u2501\u2501\u2501\u001b[0m\u001b[48;5;24m\u001b[1m\u001b[38;5;255m ACT V \u001b[0m \u001b[1m\u001b[38;5;207mThe gate: what the platform cannot decide for you\u001b[0m \u001b[38;5;240m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n  \u001b[38;5;240mreasoner:\u001b[0m \u001b[38;5;245mdeterministic reasoner (no model, fully reproducible)\u001b[0m\r\n"]
