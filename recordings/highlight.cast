[20.609046, "o", "\r\n\u001b[38;5;154m\u2501\u2501\u2501\u001b[0m\u001b[48;5;24m\u001b[1m\u001b[38;5;255m SCORECARD \u001b[0m\u001b[38;5;240m \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n"]
[20.609188, "o", "  \u001b[38;5;240mMETRIC                                \u001b[0m  \u001b[38;5;240mBEFORE         \u001b[0m  \u001b[38;5;240mAFTER           \u001b[0m  \u001b[38;5;240mDELTA          \u001b[0m\r\n  \u001b[38;5;240m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[38;5;255mtime to a reviewable change           \u001b[0m  \u001b[38;5;255m11 working days\u001b[0m  \u001b[38;5;255m1.3s            \u001b[0m  \u001b[38;5;255mqueue removed  \u001b[0m\r\n"]
