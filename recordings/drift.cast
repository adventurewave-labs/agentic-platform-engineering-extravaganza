[2.90281, "o", "    \u001b[38;5;240m\u2190\u001b[0m \u001b[38;5;44mOutOfSync \u2014 4 field(s) diverged since 2026-07-23\u001b[0m\r\n\r\n  \u001b[38;5;203m\u258d\u001b[0m \u001b[1m\u001b[38;5;203mCRITICAL \u001b[0m\u001b[1m\u001b[38;5;255mbackupRetentionDays\u001b[0m   \u001b[38;5;84m30\u001b[0m \u001b[38;5;240min git \u2192\u001b[0m \u001b[38;5;203m7\u001b[0m \u001b[38;5;240min cluster\u001b[0m\r\n    \u001b[38;5;245mout-of-band Terraform apply from the pre-platform pipeline\u001b[0m\r\n    \u001b[38;5;240mterraform-legacy-pipeline\u001b[0m \u00b7 \u001b[38;5;240m2026-08-02T19:41:02\u001b[0m \u00b7 \u001b[38;5;141mNW-PCI-003\u001b[0m\r\n    \u001b[38;5;240mimpact: \u001b[0m\u001b[38;5;255mPCI backup floor breached; 23 days of recovery window silently lost\u001b[0m\r\n\r\n"]
[3.053204, "o", "  \u001b[38;5;203m\u258d\u001b[0m \u001b[1m\u001b[38;5;203mCRITICAL \u001b[0m\u001b[1m\u001b[38;5;255mnetworkPolicy\u001b[0m   \u001b[38;5;84mpayments-ledger-default-deny\u001b[0m \u001b[38;5;240min git \u2192\u001b[0m \u001b[38;5;203mNone\u001b[0m \u001b[38;5;240min cluster\u001b[0m\r\n    \u001b[38;5;245mnamespace was recreated without reapplying the policy\u001b[0m\r\n    \u001b[38;5;240munknown\u001b[0m \u00b7 \u001b[38;5;240munknown (first abse\u001b[0m \u00b7 \u001b[38;5;141mNW-PCI-001\u001b[0m\r\n    \u001b[38;5;240mimpact: \u001b[0m\u001b[38;5;255mPCI workload has been reachable from every namespace in the cluster for 15 days\u001b[0m"]
