[24.711993, "o", "  \u001b[38;5;240msaved\u001b[0m  \u001b[1m\u001b[38;5;84m$601.67/mo\u001b[0m  \u001b[38;5;245m($7,220/yr, on one service)\u001b[0m\r\n\r\n  \u001b[38;5;245mAnd the backup window went the other way \u2014 7 days to 30 \u2014 because\u001b[0m\r\n"]
