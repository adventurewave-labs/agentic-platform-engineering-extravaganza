[18.71709, "o", "    \u001b[38;5;240m\u2190 \u001b[0m\u001b[38;5;44mrendered 1x Deployment, 1x NetworkPolicy, 1x PodDisruptionBudget, 1x SQLInstance, 1x Secret,\u001b[0m\r\n      \u001b[38;5;44m1x Service, 1x ServiceAccount\u001b[0m\r\n\r\n  \u001b[38;5;245mThe developer asked for this:\u001b[0m\r\n\u001b[38;5;240m\u256d\u2500 score.yaml \u2014 the entire database request \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n"]
[18.717248, "o", "\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;44mresources:\u001b[0m                                                                                    \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;44m  db:\u001b[0m                                                                                         \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2502 \u001b[0m  \u001b[38;5;44m    type: postgres\u001b[0m                                                                            \u001b[38;5;240m \u2502\u001b[0m\r\n\u001b[38;5;240m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n\r\n  \u001b[38;5;245mThe platform\u2019s provisioner turned it into this:\u001b[0m\r\n\u001b[38;5;141m\u256d\u2500 rendered by platform/northwind.provisioners.yaml \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mapiVersion:\u001b[0m \u001b[38;5;141mplatform.northwind.io/v1alpha1\u001b[0m                                                    \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mkind:\u001b[0m       \u001b[1m\u001b[38;5;141mSQLInstance\u001b[0m  \u001b[38;5;240m(Crossplane v2 namespaced composite)\u001b[0m                                 \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mstorageEncrypted:\u001b[0m    \u001b[38;5;84mTrue\u001b[0m                                                                     \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mpubliclyAccessible:\u001b[0m  \u001b[38;5;84mFalse\u001b[0m                                                                    \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mregion:\u001b[0m              \u001b[38;5;255meu-west-1\u001b[0m                                                                \u001b[38;5;141m \u2502\u001b[0m\r\n"]
[18.717277, "o", "\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240minstanceClass:\u001b[0m       \u001b[38;5;214mdb.r6g.xlarge\u001b[0m                                                            \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mbackupRetentionDays:\u001b[0m \u001b[38;5;214m7\u001b[0m                                                                        \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2502 \u001b[0m  \u001b[38;5;240mcostCenter:\u001b[0m          \u001b[38;5;255mCC-4471\u001b[0m                                                                  \u001b[38;5;141m \u2502\u001b[0m\r\n\u001b[38;5;141m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n\r\n  \u001b[38;5;245mPlus, without being asked: hardened securityContext, dropped\u001b[0m\r\n  \u001b[38;5;245mcapabilities, read-only rootfs, probes, PodDisruptionBudget,\u001b[0m\r\n  \u001b[38;5;245mdefault-deny NetworkPolicy, no automounted SA token, ownership\u001b[0m\r\n  \u001b[38;5;245mand cost-centre labels on every object.\u001b[0m\r\n\r\n  \u001b[1m\u001b[38;5;255mEvery violation from Act II that had one correct answer is\u001b[0m\r\n  \u001b[1m\u001b[38;5;255mnow structurally impossible. No model was consulted.\u001b[0m\r\n"]
[20.118007, "o", "\r\n\u001b[38;5;207m\u2501\u2501\u2501\u001b[0m\u001b[48;5;24m\u001b[1m\u001b[38;5;255m ACT V \u001b[0m \u001b[1m\u001b[38;5;207mThe gate: what the platform cannot decide for you\u001b[0m \u001b[38;5;240m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[0m\r\n\r\n  \u001b[38;5;240mreasoner:\u001b[0m \u001b[38;5;245mdeterministic reasoner (no model, fully reproducible)\u001b[0m\r\n"]
