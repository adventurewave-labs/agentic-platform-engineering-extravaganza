[9.492981, "o", "\r\n  \u001b[38;5;240m 1.\u001b[0m \u001b[1m\u001b[38;5;203mNW-K8S-001\u001b[0m  \u001b[38;5;255mDeployment/payments-ledger container \"payments-ledger\": image\u001b[0m\r\n                  \u001b[38;5;255m\"payments-ledger:latest\" is not immutably pinned\u001b[0m\r\n      \u001b[38;5;240mfix \u2192 \u001b[0m\u001b[38;5;214mpin to a semver tag or @sha256 digest in score.yaml containers.payments-ledger.image\u001b[0m\r\n"]
